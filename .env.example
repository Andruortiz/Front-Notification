VITE_API_BASE_URL=http://localhost:8060
VITE_TENANT_ID=demo-tenant
VITE_AUTH_TOKEN=

# Opcional: permite generar el token de este navegador para probar el canal PUSH.
# Valores de Firebase Console: Configuracion del proyecto > Tus apps (web) y Cloud Messaging > Certificados push web.
# Deben ser del mismo proyecto de Firebase que usa el backend. Si falta alguno, el boton no aparece.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
